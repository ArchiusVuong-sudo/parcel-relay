# Copy to .env to override. Every variable is optional.

# Port and address for the API and dashboard.
PORT=4115
HOST=127.0.0.1

# Where PGlite and the raw email blobs live.
DATA_DIR=./data

# 1 = always replay the recorded model run (no login or key needed).
DEMO_REPLAY=

# Model for the live call: claude-sonnet-5-5 (default), claude-opus-5-5 or claude-haiku-5-5.
LLM_MODEL=claude-sonnet-5-5

# Only needed when there is no local Claude Code login.
ANTHROPIC_API_KEY=

# silent turns off request logs.
LOG_LEVEL=
