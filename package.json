{
  "name": "parcel-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Khanh Vuong Tuan",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "description": "Turns supplier shipping emails into validated tracking uploads on the right marketplace orders.",
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "npm run build && node dist/server/main.js",
    "serve": "node dist/server/main.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "LIVE=1 vitest run tests/live",
    "smoke": "tsx scripts/smoke.ts",
    "record-fixture": "tsx scripts/record-fixture.ts"
  }
}
